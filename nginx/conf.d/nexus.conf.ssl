# NEXUS — storefront + API
# Enable after certs exist: cp nexus.conf.ssl nexus.conf  (see scripts/setup-nexus-ssl.sh)

server {
  listen 80;
  server_name nexus.hassansrour.me;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  server_name nexus.hassansrour.me;

  ssl_certificate     /etc/letsencrypt/live/nexus.hassansrour.me/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/nexus.hassansrour.me/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  client_max_body_size 20m;

  location / {
    proxy_pass http://nx-storefront:8000;
    include /etc/nginx/snippets/proxy-params.conf;
  }
}

server {
  listen 80;
  server_name api-nexus.hassansrour.me;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  server_name api-nexus.hassansrour.me;

  ssl_certificate     /etc/letsencrypt/live/api-nexus.hassansrour.me/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/api-nexus.hassansrour.me/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  client_max_body_size 20m;

  location / {
    proxy_pass http://nx-backend:9000;
    include /etc/nginx/snippets/proxy-params.conf;
  }
}
