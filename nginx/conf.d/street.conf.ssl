# Performance Street — storefront + API
server {
  listen 80;
  server_name street.hassansrour.me;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  server_name street.hassansrour.me;

  ssl_certificate     /etc/letsencrypt/live/street.hassansrour.me/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/street.hassansrour.me/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  client_max_body_size 20m;

  location / {
    proxy_pass http://ps-storefront:8000;
    include /etc/nginx/snippets/proxy-params.conf;
  }
}

server {
  listen 80;
  server_name api-street.hassansrour.me;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  server_name api-street.hassansrour.me;

  ssl_certificate     /etc/letsencrypt/live/api-street.hassansrour.me/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/api-street.hassansrour.me/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  client_max_body_size 20m;

  location / {
    proxy_pass http://ps-backend:9000;
    include /etc/nginx/snippets/proxy-params.conf;
  }
}
